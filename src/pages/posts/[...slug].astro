---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

// Note: the glob loader adopts the frontmatter `slug` as the entry id, so
// post.id always equals post.data.slug and cannot be used to detect a filename
// that has drifted from its slug. That convention is asserted in the audit
// (tools/audit/static-checks.mjs) instead, where it can actually fail.
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedDate={post.data.date}
  ogType="article"
>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <FormattedDate date={post.data.date} class="meta" />
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>
