---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const description = 'Prashanth HN — writing about cycling, food experiments, and building things.';
---

<BaseLayout title="Prashanth HN" description={description} showBackLink={false}>
  <header class="site-header">
    <h1>Prashanth HN</h1>
    <p class="intro meta">Writing about cycling, food experiments, and building things.</p>
  </header>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.data.slug}`}>
            <span class="title">{post.data.title}</span>
            <p class="excerpt">{post.data.description}</p>
            <FormattedDate date={post.data.date} class="meta" />
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
