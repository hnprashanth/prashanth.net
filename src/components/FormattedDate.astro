---
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<time datetime={date.toISOString()} class={className}>{formatted}</time>
